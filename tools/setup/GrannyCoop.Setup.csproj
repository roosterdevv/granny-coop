<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GrannyCoop-Setup</AssemblyName>
    <RootNamespace>GrannyCoop.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Granny Co-op Setup</Product>
    <Company>granny-coop</Company>
    <Copyright>MIT, 2026</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- x64: a 32-bit process would resolve Program Files to the (x86) folder and
         miss the .NET runtime it is looking for -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- the payload zip is incompressible already; skip the extra pass -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- net48 reference assemblies, so the installer builds on a machine that only
         has the .NET SDK (no Visual Studio) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload\MelonLoader.x64.zip" LogicalName="payload.MelonLoader.zip" />
    <EmbeddedResource Include="payload\dotnet-runtime-6.0.36-win-x64.exe" LogicalName="payload.dotnet6.exe" />
    <EmbeddedResource Include="$(ModDll)" LogicalName="payload.GrannyCoop.dll" Condition="Exists('$(ModDll)')" />
  </ItemGroup>

  <PropertyGroup Condition="'$(ModDll)' == ''">
    <ModDll>$(MSBuildThisFileDirectory)..\..\bin\Release\GrannyCoop.dll</ModDll>
  </PropertyGroup>

  <Target Name="RequirePayload" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(ModDll)')"
           Text="GrannyCoop.dll not found at $(ModDll). Build the mod first: dotnet build -c Release." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)payload\MelonLoader.x64.zip')"
           Text="payload\MelonLoader.x64.zip is missing. Run tools\build-setup.ps1 (it downloads and verifies it)." />
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)payload\dotnet-runtime-6.0.36-win-x64.exe')"
           Text="payload\dotnet-runtime-6.0.36-win-x64.exe is missing. Run tools\build-setup.ps1." />
  </Target>

</Project>
